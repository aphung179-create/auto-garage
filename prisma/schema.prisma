generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECEPTIONIST
  TECHNICIAN
  CUSTOMER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKING
  REPAIRING
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id          Int       @id @default(autoincrement())
  name        String
  email       String    @unique
  password    String
  role        Role      @default(CUSTOMER)
  createdAt   DateTime  @default(now())
  customer    Customer?
  technician  Technician?
}

model Customer {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  phone       String?
  address     String?
  user        User      @relation(fields: [userId], references: [id])
  vehicles    Vehicle[]
  appointments Appointment[]
}

model Technician {
  id           Int           @id @default(autoincrement())
  userId       Int           @unique
  specialty    String?
  user         User          @relation(fields: [userId], references: [id])
  repairOrders RepairOrder[]
}

model Vehicle {
  id           Int       @id @default(autoincrement())
  customerId   Int
  brand        String
  model        String
  licensePlate String    @unique
  year         Int?
  mileage      Int?
  customer     Customer  @relation(fields: [customerId], references: [id])
  appointments Appointment[]
  repairOrders RepairOrder[]
}

model Service {
  id           Int           @id @default(autoincrement())
  name         String
  description  String?
  price        Decimal       @db.Decimal(12, 2)
  durationMin  Int?
  appointments Appointment[]
  repairItems  RepairItem[]
}

model Appointment {
  id          Int               @id @default(autoincrement())
  customerId  Int
  vehicleId   Int
  serviceId   Int
  date        DateTime
  note        String?
  status      AppointmentStatus @default(PENDING)
  customer    Customer          @relation(fields: [customerId], references: [id])
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id])
  service     Service           @relation(fields: [serviceId], references: [id])
  repairOrder RepairOrder?
  createdAt   DateTime          @default(now())
}

model RepairOrder {
  id             Int            @id @default(autoincrement())
  appointmentId  Int            @unique
  vehicleId      Int
  technicianId   Int?
  diagnosis      String?
  note           String?
  status         AppointmentStatus @default(CHECKING)
  appointment    Appointment    @relation(fields: [appointmentId], references: [id])
  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id])
  technician     Technician?    @relation(fields: [technicianId], references: [id])
  inspections    Inspection[]
  repairItems    RepairItem[]
  quote          Quote?
}

model Inspection {
  id            Int         @id @default(autoincrement())
  repairOrderId Int
  itemName      String
  condition     String
  note          String?
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id])
}

model RepairItem {
  id            Int         @id @default(autoincrement())
  repairOrderId Int
  serviceId     Int
  quantity      Int         @default(1)
  price         Decimal     @db.Decimal(12, 2)
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id])
  service       Service     @relation(fields: [serviceId], references: [id])
}

model Quote {
  id            Int         @id @default(autoincrement())
  repairOrderId Int         @unique
  total         Decimal     @db.Decimal(12, 2)
  status        QuoteStatus @default(DRAFT)
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id])
  payment       Payment?
}

model Payment {
  id            Int           @id @default(autoincrement())
  quoteId       Int           @unique
  amount        Decimal       @db.Decimal(12, 2)
  method        String
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  quote         Quote         @relation(fields: [quoteId], references: [id])
}

model Review {
  id         Int      @id @default(autoincrement())
  customerId Int
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}
